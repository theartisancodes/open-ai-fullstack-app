# OpenAI (429 = rate limit from OpenAI; wait or check usage at platform.openai.com)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_ai_fullstack_app

# External API base URL for fetch demos
EXTERNAL_API_BASE_URL=https://jsonplaceholder.typicode.com

# NextAuth (required for session and protected API routes)
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars
NEXTAUTH_URL=http://localhost:3000
